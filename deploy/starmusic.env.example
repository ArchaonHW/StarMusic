# 複製為 /opt/starmusic/starmusic.env 並填入實際值
# chmod 600 /opt/starmusic/starmusic.env && chown starmusic:starmusic

# JWT 簽章密鑰(必填,至少 32 bytes;可用 openssl rand -hex 32 產生)
STARMUSIC_JWT_SECRET=

# 種子帳號密碼(必填;不設的話會產生隨機密碼印在服務日誌)
STARMUSIC_ADMIN_PASSWORD=
STARMUSIC_DEMO_PASSWORD=

# 前端網域(逗號分隔多個;Gateway CORS 白名單)
STARMUSIC_ALLOWED_ORIGINS=https://your-domain.example

# 切換 MySQL 時才需要(三個服務的 mysql profile):
# SPRING_PROFILES_ACTIVE=mysql
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
